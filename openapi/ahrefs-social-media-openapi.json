                },
                "token_validity": {
                  "type": "string",
                  "title": "token_validity",
                  "description": "Validity of the channel's authentication token (valid, expired, lost_access)."
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object",
        "xml": { "name": "AhrefsApiResponse" }
