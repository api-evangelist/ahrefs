                  "type": [ "string", "null" ],
                  "title": "channel_id",
                  "description": "Unique identifier for the social media channel."
                },
                "channel_kind": {
                  "type": [ "string", "null" ],
                  "title": "channel_kind",
                  "description": "Social media platform and account type."
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time",
                  "title": "created_at",
